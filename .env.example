# Klenic — environment variables
# Copy this file to `.env.local` and fill in real values. Never commit `.env.local`.

# --- Database: local PostgreSQL (Step 1: required) ---
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Create the database first (see README / scripts), then set your password here.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/klenic

# --- First Super Admin seed (used by `npm run db:seed`) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@klenic.local
SEED_ADMIN_PASSWORD=change-me-now

# --- AI (added in later steps) ---
# ANTHROPIC_API_KEY=your-anthropic-key
# OPENAI_API_KEY=your-openai-key

# --- WhatsApp / AiSensy (added in later steps) ---
# AISENSY_API_KEY=your-aisensy-key
AISENSY_RECALL_CAMPAIGN=recall_reminder
# Template for "your appointment was cancelled" notices ({{1}} patient, {{2}} doctor, {{3}} time, {{4}} clinic)
AISENSY_CANCEL_CAMPAIGN=appointment_cancelled
# Template for booking confirmations ({{1}} patient, {{2}} doctor, {{3}} time, {{4}} hours, {{5}} fee, {{6}} clinic)
AISENSY_BOOKING_CAMPAIGN=appointment_booked
# Secret protecting the recall cron endpoint (Vercel Cron sends it automatically)
CRON_SECRET=

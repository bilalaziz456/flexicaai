# FlexicaAI — environment variables
# Copy this file to `.env.local` and fill in real values. Never commit `.env.local`.
#
# `src/core/lib/env.ts` is the authoritative list — every variable is declared and
# zod-validated there, in one place. If you add one there, add it here in the same
# commit: this file is what a production box gets provisioned from, and a variable
# that exists only in the schema is one nobody knows to set.
#
# THE TWO THAT FAIL SILENTLY (set them explicitly in production — see below):
# STORAGE_DIR and APP_URL both have working local defaults, so a misconfigured
# server boots happily and is wrong in ways nothing reports.

# --- Database: local PostgreSQL (Step 1: required) ---
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Create the database first (see README / scripts), then set your password here.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/flexicaai

# --- First Super Admin seed (used by `npm run db:seed`) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@flexicaai.local
SEED_ADMIN_PASSWORD=change-me-now

# --- Public URL of this app ---
# Used to build absolute links that LEAVE the server — the prescription PDF link
# sent over WhatsApp, password-reset emails — and to derive
# `serverActions.allowedOrigins` in next.config.ts, so the production hostname is
# declared exactly once.
# ⚠️ Defaults to http://localhost:3000 and does NOT fail if wrong: a production box
# that never sets this quietly texts patients a localhost link.
APP_URL=http://localhost:3000

# --- File storage (audio, PDFs, photos, attachments, clinic logos) ---
# Where clinical files live on disk. In production use an ABSOLUTE path OUTSIDE the
# deploy directory (e.g. /var/lib/flexicaai/storage), or a redeploy wipes it.
# ⚠️ Defaults to the RELATIVE "./storage", resolved against the process working
# directory — so a systemd unit with a different WorkingDirectory silently writes
# patient attachments somewhere you are not backing up.
# BACK THIS UP TOGETHER WITH POSTGRES: they are one dataset (ADR-010). A database
# restored without the matching files leaves rows pointing at attachments that no
# longer exist.
STORAGE_DIR=./storage

# --- Brand contact on exported / printed documents AND the marketing site ---
# The website + phone shown in the "Powered by …" footer of every CSV report, the
# prescription PDF, and all printable invoices / receipts / statements — and, via
# `(marketing)/contact-details.ts`, the public site's footer, contact page and
# privacy page. NEXT_PUBLIC_* so client print components inline them at BUILD time,
# which means changing either needs a rebuild, not just a restart.
# Defaults: www.flexicaai.com / 03010186111.
NEXT_PUBLIC_BRAND_WEBSITE=www.flexicaai.com
NEXT_PUBLIC_BRAND_PHONE=03010186111

# The SAME number in the form wa.me and schema.org require (E.164 without the +).
# Set both together or the printed footer and the WhatsApp button disagree.
NEXT_PUBLIC_SALES_WHATSAPP=923010186111

# --- AI: the voice scribe (Claude structures, Whisper transcribes) ---
# OPTIONAL — the app boots and everything else works without them; the scribe route
# answers a clear 400. Two different vendors on purpose: they fail independently.
# ANTHROPIC_API_KEY=your-anthropic-key
# OPENAI_API_KEY=your-openai-key

# --- WhatsApp / AiSensy (added in later steps) ---
# OPTIONAL — without a key the app still LOGS every outbound message (queued), so
# nothing is lost; sends fail with a clear message.
# AISENSY_API_KEY=your-aisensy-key
# AiSensy campaign endpoint. Only change this if AiSensy moves it.
AISENSY_API_URL=https://backend.aisensy.com/campaign/t1/api/v2
# Campaign (approved template) used to deliver a prescription PDF link.
AISENSY_RX_CAMPAIGN=prescription
AISENSY_RECALL_CAMPAIGN=recall_reminder
# Template for "your appointment was cancelled" notices ({{1}} patient, {{2}} doctor, {{3}} time, {{4}} clinic)
AISENSY_CANCEL_CAMPAIGN=appointment_cancelled
# Template for booking confirmations ({{1}} patient, {{2}} doctor, {{3}} time, {{4}} hours, {{5}} fee, {{6}} clinic)
AISENSY_BOOKING_CAMPAIGN=appointment_booked
# Template for the day-before reminder ({{1}} patient, {{2}} doctor, {{3}} time, {{4}} clinic)
AISENSY_REMINDER_CAMPAIGN=appointment_reminder
# Generic reply template for WhatsApp reschedule requests ({{1}} = message text)
AISENSY_RESCHEDULE_CAMPAIGN=reschedule_reply
# Generic reply template for WhatsApp booking requests ({{1}} = message text)
AISENSY_BOOKING_REPLY_CAMPAIGN=booking_reply
# Invoice/bill delivery template. Params: {{1}} patient, {{2}} clinic,
# {{3}} invoice ref/date, {{4}} total, {{5}} paid, {{6}} outstanding
AISENSY_INVOICE_CAMPAIGN=invoice
# "Your crown/denture is ready" lab notification. Params: {{1}} patient, {{2}} item
AISENSY_LAB_CAMPAIGN=lab_ready

# ---- WhatsApp via Meta Cloud API (per-clinic sender numbers) ----
# See docs/whatsapp-cloud-plan.md. Leave WHATSAPP_PROVIDER=aisensy (or unset) to
# keep the current single-number behaviour; set it to "cloud" to send via Meta
# Cloud API, where each clinic's whatsapp_phone_number_id chooses the sender.
WHATSAPP_PROVIDER=aisensy
# System-user access token for the WABA that holds every clinic number + templates
WHATSAPP_CLOUD_TOKEN=
# The WhatsApp Business Account id
WHATSAPP_WABA_ID=
# Graph API version (e.g. v21.0)
WHATSAPP_API_VERSION=v21.0
# Token echoed back on the Cloud API webhook verification (GET hub.challenge)
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret — verifies X-Hub-Signature-256 on inbound Cloud webhooks
WHATSAPP_APP_SECRET=

# --- Secrets on public, unauthenticated surfaces ---
# All three are optional in the schema but PRODUCTION-REQUIRED at the request
# boundary: the surface fails closed (401 / disabled) rather than failing the build,
# so a missing one is loud, not silent. (conventions.md §8, §15.)
#
# Bearer token every /api/cron/* route checks, in constant time. `deploy/install-cron.sh`
# puts it in /etc/flexicaai/cron.env and refuses to install until it authenticates.
CRON_SECRET=
# Shared token AiSensy appends (?token=) when calling our inbound webhook. Without it
# the webhook 401s — which matters because inbound drives patient self-service booking.
WHATSAPP_WEBHOOK_TOKEN=
# HMAC secret signing public, unguessable, expiring links (the prescription PDF a
# patient opens from WhatsApp). Without it those links are disabled entirely.
LINK_SIGNING_SECRET=

# ---- Email (SMTP) — transactional email, e.g. password reset. OPTIONAL: leave
# blank and the app boots the same (the email channel no-ops with a log). Works with
# any SMTP provider — Amazon SES, Resend, Postmark, Gmail, … Set at deploy (§Z).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true for port 465 (implicit TLS); false for 587 (STARTTLS)
SMTP_SECURE=false
# From header, e.g. "FlexicaAI <no-reply@yourdomain.com>" (falls back to SMTP_USER)
EMAIL_FROM=

# ---- Observability (core/observability) ----
# Lowest severity to emit: error | warn | info. Default "info".
LOG_LEVEL=info
# OPTIONAL external error sink. Reports are ALWAYS written to stdout/stderr as
# structured JSON (which the host already collects), so this is purely additive:
# set it to a Sentry/Betterstack/Slack-style ingest URL to also POST each report
# there (fire-and-forget, 3s timeout). Leave empty for local logs only.
OBSERVABILITY_WEBHOOK_URL=

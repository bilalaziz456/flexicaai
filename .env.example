# Klenic — environment variables
# Copy this file to `.env.local` and fill in real values. Never commit `.env.local`.

# --- Supabase (Step 1: required) ---
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public anon key (safe for the browser; respects Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — SERVER ONLY, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI (added in later steps) ---
# ANTHROPIC_API_KEY=your-anthropic-key
# OPENAI_API_KEY=your-openai-key

# --- WhatsApp / AiSensy (added in later steps) ---
# AISENSY_API_KEY=your-aisensy-key
